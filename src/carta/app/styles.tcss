/* Carta Global Styles - Elia-inspired with custom palette */

/* Custom color palette */
$carta-lightest: #cad2c5;
$carta-light: #84a98c;
$carta-mid: #52796f;
$carta-dark: #354f52;
$carta-darkest: #2f3e46;

/* Map to border/accent colors */
$main-border-color: $carta-mid 50%;
$main-border-color-focus: $carta-light 100%;
$main-border-text-color: $carta-light;

/* Global scrollbar styling */
* {
    scrollbar-color: $carta-light 30%;
    scrollbar-color-hover: $carta-light 50%;
    scrollbar-color-active: $carta-light 80%;
    scrollbar-background: $carta-darkest;
    scrollbar-size-vertical: 1;
}

/* Base screen styles */
Screen {
    background: $carta-darkest;
    padding: 0 2 1 2;
}

/* Hide header for cleaner look */
Header {
    display: none;
}

/* Footer - transparent with accent keys */
Footer {
    background: transparent;
    margin: 3 0 0 0;
}

Footer FooterKey {
    background: transparent;
}

Footer .footer-key--key {
    color: $carta-light;
    background: transparent;
}

/* LoadingIndicator */
LoadingIndicator {
    background: transparent;
    color: $carta-light;
}

/* TextArea styling (for PromptInput) */
TextArea {
    border: round $main-border-color;
    border-title-color: $main-border-text-color;
    border-subtitle-color: $main-border-text-color;
    padding: 1 2;
    margin: 0 0 2 0;
    background: $carta-darkest;
}

TextArea:focus {
    border: round $main-border-color-focus;
    border-title-style: bold;
}

/* Button variants */
Button {
    min-width: 12;
    background: $carta-mid;
}

Button:hover {
    background: $carta-light;
}

Button.-primary {
    background: $carta-light;
    color: $carta-darkest;
}

Button.-warning {
    background: #eab308;
    color: $carta-darkest;
}

/* Notification styling */
Toast {
    background: $carta-dark;
    border-right: none;
    border-left: outer $carta-light;
}

/* Modal overlay */
ModalScreen {
    background: black 50%;
    padding: 0;
}

/* Help Screen Modal */
HelpScreen {
    align: center middle;
}

HelpScreen > Vertical {
    width: 60;
    height: auto;
    max-height: 80%;
    background: $carta-dark;
    border: round $main-border-color;
    padding: 1 2;
}

HelpScreen .help-title {
    text-align: center;
    text-style: bold;
    color: $carta-light;
    margin-bottom: 1;
}

HelpScreen .help-section {
    margin-top: 1;
    text-style: bold;
    color: $carta-light;
}

HelpScreen .help-item {
    margin-left: 2;
}

HelpScreen .help-key {
    color: $carta-light;
}

HelpScreen .help-footer {
    margin-top: 2;
    text-align: center;
    color: $carta-mid;
}

/* Confirm Quit Modal */
ConfirmQuitScreen {
    align: center middle;
}

ConfirmQuitScreen > Vertical {
    width: 50;
    height: auto;
    background: $carta-dark;
    border: round #eab308 50%;
    padding: 1 2;
}

ConfirmQuitScreen .confirm-title {
    text-align: center;
    text-style: bold;
    color: #eab308;
    margin-bottom: 1;
}

ConfirmQuitScreen .confirm-message {
    text-align: center;
    margin-bottom: 1;
}

ConfirmQuitScreen .confirm-hint {
    text-align: center;
    color: $carta-mid;
    margin-bottom: 1;
}

ConfirmQuitScreen Horizontal {
    align: center middle;
    height: auto;
}

ConfirmQuitScreen Button {
    margin: 0 1;
}

/* Agent output area */
AgentOutput {
    border: none;
    padding: 1;
    background: $carta-darkest;
}

/* RichLog text colors */
RichLog {
    background: $carta-darkest;
}

/* Question selector styling */
QuestionSelector {
    padding: 1;
}

QuestionSelector .question-header {
    color: $carta-light;
}

/* OptionList styling */
OptionList {
    background: $carta-dark 15%;
}

OptionList > .option-list--option-highlighted {
    background: $carta-mid 15%;
    color: $carta-lightest;
    text-style: none;
}

OptionList:focus > .option-list--option-highlighted {
    background: $carta-mid 80%;
    text-style: none;
}

/* ScrollableContainer */
ScrollableContainer {
    background: $carta-darkest;
}

/* Static text */
Static {
    color: $carta-lightest;
}
